<UserControl x:Class="AutoWizard.UI.Views.VariablesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:AutoWizard.Core.Models;assembly=AutoWizard.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="260">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FAFAFA" Padding="10,8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <TextBlock Text="📦 變數管理" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- 內置變數區塊 -->
                <Border Background="#F5F5F5" Padding="10" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="4" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="內置變數" FontWeight="SemiBold" FontSize="12" Foreground="#424242" Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名稱" FontSize="10" Foreground="#757575" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" 
                                      ItemsSource="{Binding BuiltInVariables}"
                                      SelectedItem="{Binding SelectedBuiltInVariable, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Padding="4,2" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="類型" FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBuiltInVariable.Type}" FontSize="11" Foreground="#424242" VerticalAlignment="Center" Margin="4,4,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="預設值" FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBuiltInVariable.DefaultValue}" FontSize="11" Foreground="#424242" VerticalAlignment="Center" Margin="4,4,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="說明" FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedBuiltInVariable.Description}" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 自訂變數區塊 -->
                <Border Background="#F5F5F5" Padding="10" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="自訂變數" FontWeight="SemiBold" FontSize="12" Foreground="#424242" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Content="🔄" ToolTip="讀取腳本更新"
                                    Command="{Binding RefreshCustomVariablesCommand}"
                                    Padding="4,2" FontSize="12"
                                    Background="Transparent" BorderBrush="Transparent" Cursor="Hand"/>
                        </Grid>
                        
                        <!-- 有變數時的顯示 -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CustomVariables.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名稱" FontSize="10" Foreground="#757575" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" 
                                      ItemsSource="{Binding CustomVariables}"
                                      SelectedItem="{Binding SelectedCustomVariable, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Padding="4,2" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="類型" FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomVariable.Type}" FontSize="11" Foreground="#424242" VerticalAlignment="Center" Margin="4,4,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="值" FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCustomVariable.DefaultValue}" FontSize="11" Foreground="#424242" VerticalAlignment="Center" Margin="4,4,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="說明" FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCustomVariable.Description}" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,4,0,0"/>
                        </Grid>

                        <!-- 無變數時的顯示 -->
                        <TextBlock Foreground="#BDBDBD" FontSize="11" TextAlignment="Center" Margin="0,10" Text="尚無自訂變數">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CustomVariables.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
